{
  "name": "move-cursor",
  "displayName": "move-cursor",
  "publisher": "milanmedvec",
  "description": "",
  "version": "0.0.6",
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "move-cursor.goToBeginBracket",
        "title": "move-cursor: Go to Begin Bracket of Nearest Pair"
      },
      {
        "command": "move-cursor.goToEndBracket",
        "title": "move-cursor: Go to End Bracket of Nearest Pair"
      },
      {
        "command": "move-cursor.moveUp5",
        "title": "move-cursor: Move Cursor Up 5 Lines"
      },
      {
        "command": "move-cursor.moveDown5",
        "title": "move-cursor: Move Cursor Down 5 Lines"
      },
      {
        "command": "move-cursor.moveLeft20",
        "title": "move-cursor: Move Cursor Left 20 Columns"
      },
      {
        "command": "move-cursor.moveRight20",
        "title": "move-cursor: Move Cursor Right 20 Columns"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.105.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@typescript-eslint/eslint-plugin": "^8.45.0",
    "@typescript-eslint/parser": "^8.45.0",
    "eslint": "^9.36.0",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2"
  }
}
